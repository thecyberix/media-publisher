# Canva (Connect API — OAuth with PKCE; thumbnails are downloaded to downloads/canva)
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# CANVA_TOKEN=credentials/canva-token.json
# GitHub Actions: store token JSON in secret CANVA_TOKEN_JSON.
# CANVA_REDIRECT_URI=http://127.0.0.1:8765/callback
# CANVA_DOWNLOAD_DIR=downloads/canva
# CANVA_LONG_VIDEO_THUMBNAILS_URL=https://canva.link/mkc9c31v441jey0
# CANVA_SHORT_VIDEO_THUMBNAILS_URL=https://canva.link/aqmh5jedqw5g0ei
# CANVA_QUOTES_FOLDER_ID=https://www.canva.com/folder/FAF9ECD0M-k
# CANVA_QUOTES_DESIGN_ID=DAHOfeZlRy4
# QUOTES_PUBLISH_TIMEZONE=Europe/Sofia
# QUOTES_PUBLISH_HOUR=8

# YouTube (Google OAuth / API — download OAuth client JSON from Google Cloud Console)
# YOUTUBE_CLIENT_SECRETS=credentials/youtube-client.json
# YOUTUBE_TOKEN=credentials/youtube-token.json
# GitHub Actions: store the full JSON file contents in repository secrets
# YOUTUBE_CLIENT_SECRETS_JSON and YOUTUBE_TOKEN_JSON (written to credentials/ at startup).
# YOUTUBE_CHANNEL_HANDLE=SadhguruBulgarian
# YOUTUBE_CHANNEL_URL=https://www.youtube.com/channel/UCg8jXnEr8ZKmuwm3S9J4e-Q
# Seconds of static cover appended to Shorts for mobile frame selection (default 2)
# YOUTUBE_SHORT_COVER_END_SECONDS=2
# YOUTUBE_PLAYLIST_TITLE=Съзнателна Планета
# YOUTUBE_PLAYLIST_ID=PLxxxxxxxx (optional; skips title lookup when set)

# Meta (Facebook + Instagram — Sadhguru Bulgarian)
# https://www.facebook.com/SadhguruBulgarian
# https://www.instagram.com/sadhguru.bulgarian/
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=            # Page token — run: python -m media_publisher --meta-setup-token <user-token>
# META_PAGE_USERNAME=SadhguruBulgarian
# META_INSTAGRAM_USERNAME=sadhguru.bulgarian
# META_PAGE_ID=
