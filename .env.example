# Airtable — Translator's Paradise in base appbIH4wzW6ZRUnF5
# https://airtable.com/appbIH4wzW6ZRUnF5/tblji1RaFztkeDn04/viw2Xz3EENcDEmarw
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appbIH4wzW6ZRUnF5
AIRTABLE_TABLE_NAME=Translator's Paradise
# Previous-years archive bases are discovered from Status "7. Not Assigned" rows
# whose Title looks like "2024 archive: https://airtable.com/...".
# Archive titles are cached permanently at output/backups/airtable-archive-titles.json.
# AIRTABLE_ARCHIVE_CACHE=true
# AIRTABLE_ARCHIVE_CACHE_REFRESH=true
# AIRTABLE_API_BASE=https://api.airtable.com/v0
# Optional view id (viw2Xz3EENcDEmarw). Leave unset for full-table API queries.
# AIRTABLE_VIEW=

# HappyScribe
# HAPPYSCRIBE_API_KEY=
# HAPPYSCRIBE_LIBRARY_URL=https://www.happyscribe.com/v2/3310225/library/23100499
# HAPPYSCRIBE_ORGANIZATION_ID=3310225
# HAPPYSCRIBE_FOLDER_ID=23100499
# HAPPYSCRIBE_PUBLISHED_FOLDER_ID=23170478
# HAPPYSCRIBE_API_BASE=https://www.happyscribe.com/api/v1
# HAPPYSCRIBE_DOWNLOAD_DIR=downloads/happyscribe
# HAPPYSCRIBE_BROWSER_STATE=credentials/happyscribe-browser.json
# HAPPYSCRIBE_BROWSER_PROFILE=credentials/happyscribe-browser-profile
# HAPPYSCRIBE_BROWSER_CHANNEL=chrome
# HAPPYSCRIBE_EMAIL=
# HAPPYSCRIBE_PASSWORD=
# HAPPYSCRIBE_FFMPEG=ffmpeg

# PUBLISH_TIMEZONE=Europe/Sofia
# PUBLISH_HOUR=18

# Canva (Connect API — shared by publishing and catalog ingest)
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# CANVA_TOKEN=credentials/canva-token.json
# GitHub Actions: store token JSON in secret CANVA_TOKEN_JSON.
# GitHub Actions / local: fine-grained PAT with Secrets read/write as CANVA_TOKEN_SYNC_PAT
# (auto-updates CANVA_TOKEN_JSON after Canva token refresh locally or in CI).
# GITHUB_REPOSITORY=thecyberix/media-publisher
# CANVA_REDIRECT_URI=http://127.0.0.1:8765/callback
# CANVA_PENDING_AUTH_PATH=credentials/canva-auth-pending.json
# CANVA_DOWNLOAD_DIR=downloads/canva
# CANVA_LONG_VIDEO_THUMBNAILS_URL=https://www.canva.com/folder/FAHOgLx_jAw
# CANVA_SHORT_VIDEO_THUMBNAILS_URL=https://www.canva.com/folder/FAHOgF-NT8Q
# CANVA_QUOTES_FOLDER_ID=https://www.canva.com/folder/FAF9ECD0M-k
# CANVA_QUOTES_DESIGN_ID=DAHOfeZlRy4
# Publish overrides (Drive + Canva Published subfolder). Requires folder:write on Canva token.
# Service account needs Drive write access to move override thumbnails to Thumbnails/Published,
# delete override videos, and remove Combined Media File after publish.
# Original platform thumbnails are uploaded to Airtable on catalog ingest (catalog-parser ingest).
# At publish time, Bulgarian thumbnails use override Drive / Canva / TN render (not the Airtable original).
# PUBLISH_OVERRIDE_DRIVE_FOLDER_ID=1nz_DZJaS-pkjvbin-lJPiYLyTft9kCzZ
# PUBLISH_OVERRIDE_THUMBNAILS_SUBFOLDER=Thumbnails
# PUBLISH_OVERRIDE_VIDEOS_SUBFOLDER=Videos
# CANVA_PUBLISHED_SUBFOLDER_NAME=Published
# TN_ORIGINAL_THUMBNAIL_DIR=downloads/original-thumbnails
# TN_CACHE_DIR=downloads/tn-cache
# TN_RENDER_OUTPUT_DIR=downloads/tn-rendered
# TN_ENGLISH_OVERRIDE_FILE=downloads/tn-english-overrides.json
# THUMBNAIL_REVIEW_DRIVE_FOLDER_ID=1lSr2x3xguVbqjBbOQN2bOR3Vbn-xhCIN
# THUMBNAIL_REVIEW_APPROVED_SUBFOLDER=Approved
# PUBLISH_MEDIA_DOWNLOAD_DIR=downloads/publish-media
# Quote image generation sources (Canva layout templates, Drive backgrounds, Sheets text):
# QUOTES_SOURCES_CONFIG=config/quotes_sources.json
# QUOTES_WORK_DIR=downloads/quotes
# QUOTES_PUBLISH_TIMEZONE=Europe/Sofia
# QUOTES_PUBLISH_HOUR=8

# YouTube (Google OAuth / API — download OAuth client JSON from Google Cloud Console)
# YOUTUBE_CLIENT_SECRETS=credentials/youtube-client.json
# YOUTUBE_TOKEN=credentials/youtube-token.json
# GitHub Actions: store the full JSON file contents in repository secrets
# YOUTUBE_CLIENT_SECRETS_JSON and YOUTUBE_TOKEN_JSON (written to credentials/ at startup).
# YOUTUBE_CHANNEL_HANDLE=SadhguruBulgarian
# YOUTUBE_CHANNEL_URL=https://www.youtube.com/channel/UCg8jXnEr8ZKmuwm3S9J4e-Q
# Seconds of static cover appended to Shorts for mobile frame selection (default 2)
# YOUTUBE_SHORT_COVER_INTRO_SECONDS=5
# YOUTUBE_SHORT_COVER_END_SECONDS=5  # legacy alias for INTRO_SECONDS
# YOUTUBE_PLAYLIST_TITLE=Съзнателна Планета
# YOUTUBE_PLAYLIST_ID=PLxxxxxxxx (optional; skips title lookup when set)

# Meta (Facebook + Instagram — Sadhguru Bulgarian)
# https://www.facebook.com/SadhguruBulgarian
# https://www.instagram.com/sadhguru.bulgarian/
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=            # Page token — run: python -m media_publisher --meta-setup-token <user-token>
# META_PAGE_USERNAME=SadhguruBulgarian
# META_INSTAGRAM_USERNAME=sadhguru.bulgarian
# META_PAGE_ID=
# META_INSTAGRAM_ACCOUNT_ID=
# META_API_VERSION=v21.0

# Channel report (monthly views → Google Sheets)
# Reuse the same service account as catalog-parser when possible:
# GOOGLE_SERVICE_ACCOUNT_JSON=<full JSON key>  (GitHub org/repo secret; see README)
# Local file fallback: GOOGLE_SHEETS_SERVICE_ACCOUNT=credentials/google-sheets-service-account.json
# Share the spreadsheet with the service account email as Editor.
# CHANNEL_REPORT_MAPPING=config/channel_report_bulgarian.json
# Inspect layout: python -m media_publisher --inspect-channel-report
# Dry run:        python -m media_publisher --dry-run-channel-report
# Monthly update: python -m media_publisher --update-channel-report
# Backfill:       python -m media_publisher --update-channel-report --channel-report-all-months
# Or:             python scripts/update_channel_report.py
# YouTube needs re-auth after adding yt-analytics.readonly scope: --youtube-auth
# Meta Page token needs read_insights; Instagram needs instagram_manage_insights.

# --- catalog-parser (ingest + daily workflow) ---

# Google Sheet catalog source
# SHEET_ID=
# SHEET_NAME=
# SHEET_RANGE=
# LIMIT=10
# VIDEO_TYPE=Reel

# SMARTCAT_ENRICH=true
# DRIVE_DOCS_ENRICH=true
# AIRTABLE_SYNC=true
# SMARTCAT_UI_BASE=https://ea.smartcat.com
# SMARTCAT_STORAGE_STATE=smartcat-state.json
# SMARTCAT_TARGET_LANGUAGE=bg
# Company API (recommended for corpus export and CI; Settings → API in Smartcat):
# SMARTCAT_API=true
# SMARTCAT_ACCOUNT_ID=
# SMARTCAT_API_KEY=
# SMARTCAT_API_BASE=https://ea.smartcat.ai

# Copy config/github_workflows.example.json to config/github_workflows.json (optional local overrides).
# GITHUB_DISPATCH_TOKEN=  # PAT with Actions: Read and write — for scripts/run_github_workflow.py
# OUTPUT_DRIVE_FOLDER=
# WORKFLOW_PROFILES_JSON=
