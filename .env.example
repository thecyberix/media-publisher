# Copy to .env. Values shown are the ones this project actually configures
# (local .env and/or GitHub Actions secrets/variables).
# AIRTABLE_BASE_ID / AIRTABLE_TABLE_NAME are derived from AIRTABLE_URL (do not set).
# Catalog spreadsheet id, reel:video ratio, and max video length: config/workflow_config.json.

# --- Airtable ---
AIRTABLE_TOKEN=
AIRTABLE_URL=https://airtable.com/appbIH4wzW6ZRUnF5/tblji1RaFztkeDn04/viw2Xz3EENcDEmarw

# --- Google Drive (parent "Automated Workflow") ---
# Named children: Combined Media Files, Events, Overrides, Quotes, Thumbnails for approval.
# SAVE SOIL stills: Overrides/Images (SaveSoilReel.jpeg, SaveSoilVideo.jpeg).
DRIVE_URL=https://drive.google.com/drive/folders/1hJZgKn2MwztFzzd7J3rGuh4xCg3su6cg

# --- Google credentials ---
# Local: credentials/google-sheets-service-account.json
# CI: repository secret GOOGLE_SERVICE_ACCOUNT_JSON (full JSON key).
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Canva ---
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Fine-grained PAT: Secrets + Variables read/write on this repo.
# Writes CANVA_TOKEN_JSON, YOUTUBE_TOKEN_JSON, and YOUTUBE_DAILY_PLAYLIST_JSON.
CONFIG_SYNC_PAT=
# Local: credentials/canva-token.json
# CI: secret CANVA_TOKEN_JSON
# CANVA_TOKEN_JSON=
CANVA_URL=https://www.canva.com/folder/FAHSXg0enw4

# --- HappyScribe ---
HAPPYSCRIBE_API_KEY=
HAPPYSCRIBE_URL=https://www.happyscribe.com/v2/3310225/library/23100499

# --- YouTube ---
# Local: credentials/youtube-client.json and credentials/youtube-token.json
# CI: secrets YOUTUBE_CLIENT_SECRETS_JSON and YOUTUBE_TOKEN_JSON
# YOUTUBE_CLIENT_SECRETS_JSON=
# YOUTUBE_TOKEN_JSON=
YOUTUBE_CHANNEL_HANDLE=SadhguruBulgarian
YOUTUBE_PLAYLIST_ID=PLpP5d0BDr0xaGn6QSPyQjG6GhK-dcm3Lm
# YOUTUBE_DAILY_PLAYLIST_JSON={"playlist_id":"...","quote":"...","reel":"...","lau":"..."}

# --- Meta ---
META_APP_ID=
META_APP_SECRET=
# Page token — python -m media_publisher --meta-setup-token <user-token>
META_ACCESS_TOKEN=
META_PAGE_USERNAME=SadhguruBulgarian
META_INSTAGRAM_USERNAME=sadhguru.bulgarian

# --- Quotes ---
TRANSLATED_QUOTES_URL=https://docs.google.com/spreadsheets/d/13Hj-v3bGVLs49ZutLx-LwQrcqUXoMcjIDNRP5h0Qmec/edit
# QUOTES_PUBLISH_HOUR=8
# GENERATED_QUOTES_NOTIFY_EMAIL=

# --- Publish schedule ---
# PUBLISH_TIMEZONE=Europe/Sofia
# VIDEOS_PUBLISH_HOUR=18

# --- Email ---
# GMAIL_SMTP_USER=
# GMAIL_SMTP_APP_PASSWORD=
# NOTIFY_EMAIL=

# --- Catalog / Smartcat ---
# Local: smartcat-state.json
# CI: secret SMARTCAT_STORAGE_STATE_JSON
# SMARTCAT_STORAGE_STATE_JSON=
# Local people: workflow_config.json. CI: repo variable WORKFLOW_PROFILES_JSON.
# WORKFLOW_PROFILES_JSON=

# --- Target locale (key in config/languages.json) ---
TARGET_LANGUAGE=Bulgarian

# Metricool Smartlink used in video captions. Required for publish workflows.
# SMARTLINK_URL=https://t-sml.mtrbio.com/public/smartlink/your-channel

# --- Translation ---
# Unset TRANSLATION_PROVIDER or TRANSLATION_API_KEY to skip AI translation.
TRANSLATION_API_KEY=
# TRANSLATION_PROVIDER=anthropic
# TRANSLATION_PROVIDER=none

# --- Local GitHub workflow dispatch ---
# GITHUB_DISPATCH_TOKEN=
